<?xml version='1.1' encoding='UTF-8'?>
<!-- Généré par Ansible (rôle jenkins) : Manage Jenkins > System > E-mail Notification -->
<hudson.tasks.Mailer_-DescriptorImpl plugin="mailer">
  <smtpHost>{{ jenkins_mail_smtp_host }}</smtpHost>
  <useSsl>false</useSsl>
  <useTls>false</useTls>
  <smtpPort>{{ jenkins_mail_smtp_port }}</smtpPort>
  <charset>UTF-8</charset>
</hudson.tasks.Mailer_-DescriptorImpl>
